# 복사해서 .env.local 로 저장 후 값 채우기 (.env.local 은 git에 올라가지 않음)
# 운영(Vercel) 환경변수는 `vercel env add <이름>` 으로 등록한다.

# ── 브라우저에 포함되는 값 (VITE_ 접두사 = 번들에 노출됨. 비밀 키 금지) ─────────────
# Supabase (Project Settings > API). 미설정 시 src/supabase.js 의 기본값 사용
VITE_SUPABASE_URL=https://tebtuzxafkymlplmlhzu.supabase.co
VITE_SUPABASE_KEY=

# Google Gemini (AI 분석). 브라우저 번들에 포함되어 노출되는 키임에 주의
VITE_GEMINI_API_KEY=

# AI 제공자 선택: auto(기본, Gemini 먼저 → 실패 시 Claude) | gemini | claude
# Gemini 구독이 끝나면 claude 로 바꾸면 된다.
VITE_AI_PROVIDER=auto

# ── 서버 전용 값 (VITE_ 없음 — 브라우저에 절대 노출되지 않음, Vercel 서버 함수 api/claude.js 에서만 사용) ──
# Claude API 키 (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
# 선택: 모델 (기본 claude-sonnet-5-5. 더 정밀하게는 claude-opus-5-5, 더 저렴하게는 claude-haiku-5-5)
ANTHROPIC_MODEL=
# 선택: 추론 깊이 low | medium(기본) | high
ANTHROPIC_EFFORT=
